{
  "name": "ableton-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Control total de Ableton Live 12 desde un iPad por WiFi",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "deploy:remote-script": "node scripts/sync-remote-script.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
